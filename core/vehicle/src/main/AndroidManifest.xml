<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        필요한 권한만 선언한다 (App Market 입점 시 사전 승인된 퍼미션만 허용). 모두 조회 권한이다.
        Pleos Vehicle SDK: Gear(주차 판정)
    -->
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />

    <!-- AAOS 표준 프로퍼티: PERF_VEHICLE_SPEED -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- NaviHelper: 현재 위치 이벤트 (목적지·남은 시간 조회도 같은 권한) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

</manifest>
